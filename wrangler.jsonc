{
  // crosbynews.com — Crosby, TX weather Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crosbynews",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",

  // Cached NWS forecast + alerts JSON live here under the "weather" key.
  "kv_namespaces": [
    {
      "binding": "WEATHER",
      "id": "da96de7daed84b69b32778058b374d5f"
    }
  ],

  // Refresh the cached weather every 15 minutes.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // Deployment identity for /api/health (id, tag, timestamp). Metadata about
  // the deploy itself — no account resource is provisioned, and the Worker
  // treats it as optional, so an environment without it degrades to null
  // rather than failing.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  "observability": {
    "enabled": true
  }
}
