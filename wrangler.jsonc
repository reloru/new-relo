{
  // crosbynews.com — Crosby, TX weather Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crosbynews",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",

  // Binary files (the PNG icons, favicon.ico, og:image) live in public/ and
  // are served by Workers static assets. run_worker_first: every request reaches
  // the Worker, which hands the icon paths to env.ASSETS (src/router.js), so
  // they get the same security headers as every other response and anything
  // not routed still 404s from the router, not the asset layer. public/ is
  // written by scripts/build-icons.mjs — regenerate, don't hand-edit.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Cached NWS forecast + alerts JSON live here under the "weather" key.
  "kv_namespaces": [
    {
      "binding": "WEATHER",
      "id": "da96de7daed84b69b32778058b374d5f"
    }
  ],

  // Kill switch for the aggregate /mcp usage counters. Anything other than
  // "on" makes them inert at every call site (see src/mcp/metrics.js), so the
  // feature can be shipped dark or disabled with a redeploy rather than a
  // code change.
  "vars": {
    "MCP_METRICS": "on"
  },

  // Refresh the cached weather every 15 minutes.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // Workers Logs off, by the owner's decision (2026-10-07). Nothing in the site
  // depends on it: the MCP usage counters live in KV, and /api/health reports
  // cron feed status from the `cron_status` KV key. What it costs is
  // diagnostics: every `console.error` in the Worker now goes nowhere, so a
  // failing flush or rollup shows up only as `rollup.ok` on /api/mcp-usage.
  // For the record: invocation logs recorded each request URL with its query
  // string (redact_query_string was false), which on the admin routes is the
  // ADMIN_KEY.
  "observability": {
    "enabled": false
  }
}
