{
  // crosbynews.com — Crosby, TX weather Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crosbynews",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",

  // Cached NWS forecast + alerts JSON live here under the "weather" key.
  "kv_namespaces": [
    {
      "binding": "WEATHER",
      "id": "da96de7daed84b69b32778058b374d5f"
    }
  ],

  // Kill switch for the aggregate /mcp usage counters. Anything other than
  // "on" makes them inert at every call site (see src/mcp/metrics.js), so the
  // feature can be shipped dark or disabled with a redeploy rather than a
  // code change.
  "vars": {
    "MCP_METRICS": "on"
  },

  // Refresh the cached weather every 15 minutes.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
